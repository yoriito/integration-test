        | Vehicle.ADAS.EBA.IsEngaged | timeout | bool | false |
        | Vehicle.ADAS.EBD.IsEnabled | reject  | bool | false |
        | Vehicle.ADAS.EBD.IsEnabled | timeout | bool | false |
