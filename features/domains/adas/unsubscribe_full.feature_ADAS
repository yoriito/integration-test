    Scenario Outline: Unsubscribe of one subscription_id does not hinder other subscription_ids
        Given a signal at <path> is set to <value_0> of datatype <datatype>
        And attempts to subscribe the signal at <path> of datatype <datatype> for <count> times with duplex <duplex> are all succeeded
        When attempts to unsubscribe the signal at <path> of datatype <datatype> is succeeded
        And the value of signal at <path> changes to <value_1> of datatype <datatype>
        Then The other subscription_ids stream returns <datatype> <value_1> on <path>

    Examples:
        | path                                                     | count         | duplex        | datatype      | value_0       | value_1       |
        | Vehicle.ADAS.ABS.IsEnabled | 2 | 1 | bool | false | true |
        | Vehicle.ADAS.ABS.IsEngaged | 2 | 1 | bool | false | true |
        | Vehicle.ADAS.ActiveAutonomyLevel | 2 | 1 | string | SAE_1 | SAE_0 |
        | Vehicle.ADAS.CruiseControl.AdaptiveDistanceSet | 2 | 1 | float | 1.70141175e+38 | 3.4028235e+38 |
        | Vehicle.ADAS.CruiseControl.AdaptiveIntervalSet | 2 | 1 | string | INTVL_2 | INTVL_1 |
        | Vehicle.ADAS.CruiseControl.DegradationStatus | 2 | 1 | string | CONTAMINATION | NO_DEGRADATION |
        | Vehicle.ADAS.CruiseControl.IsActive | 2 | 1 | bool | false | true |
        | Vehicle.ADAS.CruiseControl.IsAdaptive | 2 | 1 | bool | false | true |
        | Vehicle.ADAS.CruiseControl.IsEnabled | 2 | 1 | bool | false | true |
        | Vehicle.ADAS.CruiseControl.SpeedSet | 2 | 1 | float | 0.0 | 3.4028235e+38 |
        | Vehicle.ADAS.DMS.DegradationStatus | 2 | 1 | string | CAMERA_LENS_CONTAMINATION | NO_DEGRADATION |
        | Vehicle.ADAS.DMS.IsEnabled | 2 | 1 | bool | false | true |
        | Vehicle.ADAS.DMS.IsWarning | 2 | 1 | bool | false | true |
        | Vehicle.ADAS.EBA.IsEnabled | 2 | 1 | bool | false | true |
        | Vehicle.ADAS.EBA.IsEngaged | 2 | 1 | bool | false | true |
        | Vehicle.ADAS.EBD.IsEnabled | 2 | 1 | bool | false | true |
        | Vehicle.ADAS.EBD.IsEngaged | 2 | 1 | bool | false | true |
        | Vehicle.ADAS.ESC.IsEnabled | 2 | 1 | bool | false | true |
        | Vehicle.ADAS.ESC.IsEngaged | 2 | 1 | bool | false | true |
        | Vehicle.ADAS.ESC.IsStrongCrossWindDetected | 2 | 1 | bool | false | true |
        | Vehicle.ADAS.ESC.RoadFriction | 2 | 1 | complex | {"MostProbable":{"type":"float","value":50},"LowerBound":{"type":"float","value":50},"UpperBound":{"type":"float","value":50}} | {"MostProbable":{"type":"float","value":100},"LowerBound":{"type":"float","value":100},"UpperBound":{"type":"float","value":100}} |
        | Vehicle.ADAS.IsAutoPowerOptimize | 2 | 1 | bool | false | true |
        | Vehicle.ADAS.LaneDepartureDetection.DegradationStatus | 2 | 1 | string | CAMERA_OBSTRUCTION_DETECTED | NO_DEGRADATION |
        | Vehicle.ADAS.LaneDepartureDetection.IsEnabled | 2 | 1 | bool | false | true |
        | Vehicle.ADAS.LaneDepartureDetection.IsWarning | 2 | 1 | bool | false | true |
        | Vehicle.ADAS.ObstacleDetection.Front.Center.DegradationStatus | 2 | 1 | string | SENSOR_BLOCKED | NO_DEGRADATION |
        | Vehicle.ADAS.ObstacleDetection.Front.Center.Distance | 2 | 1 | float | 1.70141175e+38 | 3.4028235e+38 |
        | Vehicle.ADAS.ObstacleDetection.Front.Center.IsEnabled | 2 | 1 | bool | false | true |
        | Vehicle.ADAS.ObstacleDetection.Front.Center.IsWarning | 2 | 1 | bool | false | true |
