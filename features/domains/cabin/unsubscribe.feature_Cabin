    Examples:
        | path                                          | network_failure | datatype  | value     |
        | Vehicle.Cabin.Convertible.IsOpen | reject  | bool | false |
        | Vehicle.Cabin.Convertible.IsOpen | timeout | bool | false |
        | Vehicle.Cabin.Convertible.Position | reject  | uint8 | 50 |
        | Vehicle.Cabin.Convertible.Position | timeout | uint8 | 50 |
        | Vehicle.Cabin.HVAC.AmbientAirTemperature | reject  | float | 0.0 |
        | Vehicle.Cabin.HVAC.AmbientAirTemperature | timeout | float | 0.0 |
        | Vehicle.Cabin.HVAC.Station.Row1.DriverSide.AirDistribution | reject  | string | MIDDLE |
        | Vehicle.Cabin.HVAC.Station.Row1.DriverSide.AirDistribution | timeout | string | MIDDLE |
        | Vehicle.Cabin.Seat.Row1.DriverSide.Backrest.HeatingCooling | reject  | int8 | 0 |
        | Vehicle.Cabin.Seat.Row1.DriverSide.Backrest.HeatingCooling | timeout | int8 | 0 |
        | Vehicle.Cabin.Seat.Row1.DriverSide.Height | reject  | uint16 | 32767 |
        | Vehicle.Cabin.Seat.Row1.DriverSide.Height | timeout | uint16 | 32767 |
        


