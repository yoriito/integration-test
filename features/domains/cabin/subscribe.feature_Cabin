        | Vehicle.Cabin.Convertible.Position | uint8 | 50 | timeout |
        | Vehicle.Cabin.Convertible.Position | uint8 | 50 | reject  |
        | Vehicle.Cabin.HVAC.AmbientAirTemperature | float | 0.0 | timeout |
        | Vehicle.Cabin.HVAC.AmbientAirTemperature | float | 0.0 | reject  |
        | Vehicle.Cabin.HVAC.Station.Row1.DriverSide.AirDistribution | string | MIDDLE | timeout |
        | Vehicle.Cabin.HVAC.Station.Row1.DriverSide.AirDistribution | string | MIDDLE | reject  |
        | Vehicle.Cabin.Seat.Row1.DriverSide.Backrest.HeatingCooling | int8 | 0 | timeout |
        | Vehicle.Cabin.Seat.Row1.DriverSide.Backrest.HeatingCooling | int8 | 0 | reject  |
