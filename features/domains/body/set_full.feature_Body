        | Vehicle.Body.Windshield.Front.Wiping.System.Frequency | uint8 | 127 |
        | Vehicle.Body.Windshield.Front.Wiping.System.Mode | string | WIPE |
        | Vehicle.Body.Windshield.Front.Wiping.System.Position | uint8 | 50 |
        | Vehicle.Body.Windshield.Rear.IsHeatingOn | bool | false |
        | Vehicle.Body.Windshield.Rear.Wiping.Intensity | uint8 | 127 |
        | Vehicle.Body.Windshield.Rear.Wiping.Mode | string | SLOW |
        | Vehicle.Body.Windshield.Rear.Wiping.System.Frequency | uint8 | 127 |
        | Vehicle.Body.Windshield.Rear.Wiping.System.Mode | string | WIPE |
        | Vehicle.Body.Windshield.Rear.Wiping.System.Position | uint8 | 50 |
        
