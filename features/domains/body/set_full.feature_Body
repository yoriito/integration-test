# language: en

Feature: Signal API set

    @coldstart @serial
    Scenario Outline: Cold start once and seed initial actuator values
        Given Kura service is cleanly restarted
        When HeadlessApp sets the following actuator signals
        | path                                                     | datatype | value         |
        | Vehicle.Body.Hood.IsLocked | bool | false |
        | Vehicle.Body.Hood.IsOpen | bool | false |
        | Vehicle.Body.Hood.Position | uint8 | 50 |
        | Vehicle.Body.Horn.IsActive | bool | false |
        | Vehicle.Body.IsAutoPowerOptimize | bool | false |
        | Vehicle.Body.Lights.Backup.IsOn | bool | false |
        | Vehicle.Body.Lights.Beam.High.IsOn | bool | false |
        | Vehicle.Body.Lights.Beam.Low.IsOn | bool | false |
        | Vehicle.Body.Lights.Brake.IsActive | string | ACTIVE |
        | Vehicle.Body.Lights.DirectionIndicator.Left.IsSignaling | bool | false |
        | Vehicle.Body.Lights.DirectionIndicator.Right.IsSignaling | bool | false |
        | Vehicle.Body.Lights.Fog.Front.IsOn | bool | false |
        | Vehicle.Body.Lights.Fog.Rear.IsOn | bool | false |
        | Vehicle.Body.Lights.Hazard.IsSignaling | bool | false |
        | Vehicle.Body.Lights.LicensePlate.IsOn | bool | false |
        | Vehicle.Body.Lights.Parking.IsOn | bool | false |
        | Vehicle.Body.Lights.Running.IsOn | bool | false |
        | Vehicle.Body.Mirrors.DriverSide.IsFolded | bool | false |
        | Vehicle.Body.Mirrors.DriverSide.IsHeatingOn | bool | false |
        | Vehicle.Body.Mirrors.DriverSide.IsLocked | bool | false |
        | Vehicle.Body.Mirrors.DriverSide.Tilt | int8 | 0 |
        | Vehicle.Body.Mirrors.DriverSide.Yaw | int8 | 0 |
        | Vehicle.Body.Mirrors.PassengerSide.IsFolded | bool | false |
        | Vehicle.Body.Mirrors.PassengerSide.IsHeatingOn | bool | false |
        | Vehicle.Body.Mirrors.PassengerSide.IsLocked | bool | false |
        | Vehicle.Body.Mirrors.PassengerSide.Tilt | int8 | 0 |
        | Vehicle.Body.Mirrors.PassengerSide.Yaw | int8 | 0 |
        | Vehicle.Body.PowerOptimizeLevel | uint8 | 5 |
        | Vehicle.Body.RearMainSpoilerPosition | float | 50 |
        | Vehicle.Body.Trunk.Front.IsLightOn | bool | false |
        | Vehicle.Body.Trunk.Front.IsLocked | bool | false |
        | Vehicle.Body.Trunk.Front.IsOpen | bool | false |
        | Vehicle.Body.Trunk.Front.Position | uint8 | 50 |
        | Vehicle.Body.Trunk.Rear.IsLightOn | bool | false |
