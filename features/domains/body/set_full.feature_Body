        | Vehicle.Body.Lights.Fog.Front.IsOn | 20 | 10 | bool | false | true |
        | Vehicle.Body.Lights.Fog.Rear.IsOn | 20 | 10 | bool | false | true |
        | Vehicle.Body.Lights.Hazard.IsSignaling | 20 | 10 | bool | false | true |
        | Vehicle.Body.Lights.LicensePlate.IsOn | 20 | 10 | bool | false | true |
        | Vehicle.Body.Lights.Parking.IsOn | 20 | 10 | bool | false | true |
        | Vehicle.Body.Lights.Running.IsOn | 20 | 10 | bool | false | true |
        | Vehicle.Body.Mirrors.DriverSide.IsFolded | 20 | 10 | bool | false | true |
        | Vehicle.Body.Mirrors.DriverSide.IsHeatingOn | 20 | 10 | bool | false | true |
        | Vehicle.Body.Mirrors.DriverSide.IsLocked | 20 | 10 | bool | false | true |
        | Vehicle.Body.Mirrors.DriverSide.Tilt | 20 | 10 | int8 | 0 | 100 |
        | Vehicle.Body.Mirrors.DriverSide.Yaw | 20 | 10 | int8 | 0 | 100 |
        | Vehicle.Body.Mirrors.PassengerSide.IsFolded | 20 | 10 | bool | false | true |
        | Vehicle.Body.Mirrors.PassengerSide.IsHeatingOn | 20 | 10 | bool | false | true |
        | Vehicle.Body.Mirrors.PassengerSide.IsLocked | 20 | 10 | bool | false | true |
        | Vehicle.Body.Mirrors.PassengerSide.Tilt | 20 | 10 | int8 | 0 | 100 |
        | Vehicle.Body.Mirrors.PassengerSide.Yaw | 20 | 10 | int8 | 0 | 100 |
        | Vehicle.Body.PowerOptimizeLevel | 20 | 10 | uint8 | 5 | 10 |
        | Vehicle.Body.RearMainSpoilerPosition | 20 | 10 | float | 50 | 100 |
        | Vehicle.Body.Trunk.Front.IsLightOn | 20 | 10 | bool | false | true |
