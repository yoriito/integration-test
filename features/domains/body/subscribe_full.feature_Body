        | Vehicle.Body.Lights.Beam.High.IsDefect | bool | false | true |
        | Vehicle.Body.Lights.Beam.High.IsOn | bool | false | true |
        | Vehicle.Body.Lights.Beam.Low.IsDefect | bool | false | true |
        | Vehicle.Body.Lights.Beam.Low.IsOn | bool | false | true |
        | Vehicle.Body.Lights.Brake.IsActive | string | ACTIVE | INACTIVE |
        | Vehicle.Body.Lights.Brake.IsDefect | bool | false | true |
        | Vehicle.Body.Lights.DirectionIndicator.Left.IsDefect | bool | false | true |
        | Vehicle.Body.Lights.DirectionIndicator.Left.IsSignaling | bool | false | true |
        | Vehicle.Body.Lights.DirectionIndicator.Right.IsDefect | bool | false | true |
