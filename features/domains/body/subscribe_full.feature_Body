        | Vehicle.Body.Lights.Fog.Front.IsDefect | bool | false | true |
        | Vehicle.Body.Lights.Fog.Front.IsOn | bool | false | true |
        | Vehicle.Body.Lights.Fog.Rear.IsDefect | bool | false | true |
        | Vehicle.Body.Lights.Fog.Rear.IsOn | bool | false | true |
        | Vehicle.Body.Lights.Hazard.IsDefect | bool | false | true |
